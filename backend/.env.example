# Local Docker PostgreSQL settings. Replace both password placeholders together.
POSTGRES_DB=invoice_ledger
POSTGRES_USER=invoice_ledger
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# Application connection used by app init-db.
DATABASE_URL=postgresql+psycopg://invoice_ledger:replace_me@127.0.0.1:5432/invoice_ledger

# Login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password

# OpenAI API key
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-6-luna"
