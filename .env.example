# Local Docker PostgreSQL settings. Replace both password placeholders together.
POSTGRES_DB=invoice_ledger
POSTGRES_USER=invoice_ledger
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# Application connection; CLI placeholders do not use this yet.
# URL-encode passwords with special characters in this URL.
DATABASE_URL=postgresql+psycopg://invoice_ledger:replace_me@127.0.0.1:5432/invoice_ledger
